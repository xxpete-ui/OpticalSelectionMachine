    <widget class="QScrollArea" name="scrollArea">
     <property name="styleSheet">
      <string notr="true">QScrollBar{
	
	background-color: rgba(255, 255, 255, 30);
}
/* 垂直滚动条整体背景 */
QScrollBar:vertical {
     /* background: #2c2c2c;         背景色 */
	background-color: rgba(64, 64, 64, 0);
    width: 6px;                  /* 滚动条宽度 */
    margin: 0px;
    border-radius: 3px;           /* 整体圆角 */
}

/* 垂直滚动条的滑块 */
QScrollBar::handle:vertical {
    background: rgba(64, 64, 64, 150);          /* 滑块颜色 */
    min-height: 20px;             /* 滑块最小高度 */
    border-radius:3px;           /* 滑块圆角 */
}

/* 鼠标悬停时的滑块 */
QScrollBar::handle:vertical:hover {
    background: rgba(84, 84, 84, 150);          /* 悬停颜色 */
}

/* 滑块按下时的样式 */
QScrollBar::handle:vertical:pressed {
    background: #a0a0a0;
}

/* 去掉上下箭头按钮（如果需要） */
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: none;
    border: none;
    height: 0px;
    width: 0px;
}

/* 去掉上下箭头按钮的占位空间 */
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

/* 水平滚动条类似 */
QScrollBar:horizontal {
    background: rgba(64, 64, 64, 0);
    height: 6px;
    margin: 0px;
    border-radius: 3px;
}
QScrollBar::handle:horizontal {
    background: rgba(64, 64, 64, 150);
    min-width: 20px;
    border-radius: 3px;
}
QScrollBar::handle:horizontal:hover {
    background:  rgba(84, 84, 84, 150);
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    height: 0px;
    width: 0px;
}</string>
